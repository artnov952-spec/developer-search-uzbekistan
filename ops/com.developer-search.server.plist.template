<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.developer-search.server</string>
  <key>ProgramArguments</key><array><string>__REPOSITORY_PATH__/scripts/run-server-local.sh</string></array>
  <key>WorkingDirectory</key><string>__REPOSITORY_PATH__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__REPOSITORY_PATH__/logs/server.stdout.log</string>
  <key>StandardErrorPath</key><string>__REPOSITORY_PATH__/logs/server.stderr.log</string>
  <key>ProcessType</key><string>Background</string>
</dict></plist>
