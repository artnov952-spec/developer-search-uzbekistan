# Copy to .env.local and export it before starting the backend. Never commit real values.
DEVELOPER_SEARCH_TELEGRAM_BOT_TOKEN=
DEVELOPER_SEARCH_ALLOWED_TELEGRAM_USER_IDS=910449149
# Generate with: openssl rand -base64 48
DEVELOPER_SEARCH_SESSION_SECRET=
DEVELOPER_SEARCH_DB_PATH=./data/developer-search.sqlite
DEVELOPER_SEARCH_APP_ORIGIN=http://localhost:4180
# polling is the recommended local Mac mini mode; webhook requires HTTPS and the secret below.
TELEGRAM_MODE=polling
DEVELOPER_SEARCH_TELEGRAM_WEBHOOK_SECRET=
HOST=127.0.0.1
PORT=4182
NODE_ENV=development
